name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: artifact of raw data set from W&B
        type: str

      output_artifact:
        description: name of artifact created which is the cleaned data set
        type: str

      output_type:
        description: the type of artifact which is cleaned dataset
        type: str

      output_description:
        description: description of the artifact
        type: str

      min_price:
        description: the minimum price that will be in the cleaned dataset
        type: float

      max_price:
        description: the maximum price that will be in the cleaned dataset
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
